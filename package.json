{
  "name": "cloud-agent",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "start": "pnpm --filter @cloud-agent/mobile start:lan",
    "mobile": "pnpm --filter @cloud-agent/mobile start:lan",
    "mobile:tunnel": "pnpm --filter @cloud-agent/mobile start",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "ca:pair": "pnpm --filter @cloud-agent/daemon pair"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "prettier": "^3.8.3",
    "tsx": "^4.23.15",
    "turbo": "^2.5.4",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
