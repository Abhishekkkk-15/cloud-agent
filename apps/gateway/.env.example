PORT=8080
DATABASE_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Cluster0
DATABASE_NAME=cloud-agent
JWT_SECRET=your-secure-jwt-secret-matching-api
CORS_ORIGIN=*

# Google OAuth Credentials (Web Application Client ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Deployed Public Gateway OAuth Callback URL
# Example: https://gateway.yourdomain.com/auth/google/callback or https://<render-service-name>.onrender.com/auth/google/callback
GOOGLE_REDIRECT_URI=https://<your-deployed-domain>/auth/google/callback
