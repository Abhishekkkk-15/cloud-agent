# Cloud Agent Mobile Client Configuration

# Deployed Backend API Endpoint (FastAPI)
# Default: dynamically resolved from Metro host (http://<your-lan-ip>:8000)
EXPO_PUBLIC_API_URL=https://api.yourdomain.com

# Deployed Gateway Hub Endpoint (Node.js WebSocket & Signaling)
# Default: dynamically resolved from Metro host (http://<your-lan-ip>:8080)
EXPO_PUBLIC_GATEWAY_URL=https://gateway.yourdomain.com

# Google OAuth Web Client ID (Optional for Google Sign-in)
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
