# Cloud Agent Mobile Client Configuration

# Deployed Unified Backend / Gateway Endpoint
# Default: https://gateway.cloud-agent.abhishekkkk.in
EXPO_PUBLIC_API_URL=https://gateway.cloud-agent.abhishekkkk.in

# Deployed Gateway Hub Endpoint (Node.js WebSocket & Signaling)
# Default: https://gateway.cloud-agent.abhishekkkk.in
EXPO_PUBLIC_GATEWAY_URL=https://gateway.cloud-agent.abhishekkkk.in

# Google OAuth Web Client ID (Optional for Google Sign-in)
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
