{
  "expo": {
    "name": "Cloud Agent",
    "slug": "cloud-agent",
    "scheme": "cloud-agent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "android": {
      "package": "com.cloudagent.mobile",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1117"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "androidNavigationBar": {
        "backgroundColor": "#0d1117",
        "barStyle": "light-content"
      },
      "androidStatusBar": {
        "backgroundColor": "#00000000",
        "translucent": true,
        "barStyle": "light-content"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0077b6",
          "defaultChannel": "agent-alerts"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Cloud Agent to access your microphone for voice dictation.",
          "speechRecognitionPermission": "Allow Cloud Agent to transcribe your voice prompts."
        }
      ]
    ],
    "owner": "abhishek-15s-team",
    "extra": {
      "eas": {
        "projectId": "a3cb31cf-6c3f-4979-babe-45a2ea20a75e"
      }
    }
  }
}