# ==============================================================================
# Cloud Agent Backend Environment Configuration
# ==============================================================================

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JWT Authentication ---
JWT_SECRET=dev-cloud-agent-jwt-change-me

# --- GitHub Integration & Platform Bot ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/integrations/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=
# Platform bot credentials (used when a user has not connected personal GitHub)
GITHUB_DEFAULT_TOKEN=
GITHUB_DEFAULT_LOGIN=

# --- Web Frontend Application ---
WEB_APP_URL=http://localhost:5173

# --- MongoDB Database ---
DATABASE_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=cloud-agent
MONGODB_PING_TIMEOUT_MS=10000

# --- Primary Agent Model Defaults ---
# (Can also be configured dynamically in Admin Console: /admin?tab=agent)
API_KEY=
PROVIDER=openai
MODEL=gpt-5.6-luna
BASE_URL=https://api.openai.com/v1
AUTONOMOUS=true

# --- Model Provider Secrets ---
# (Referenced by api_key_env in AI Models table; kept strictly in .env)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Agent Context Window & Compaction Defaults ---
COMPACTION_ENABLED=true
COMPACT_AT_TOKENS=20000
KEEP_RECENT_TOKENS=6000

# --- Docker Sandbox & Workspace Mounts ---
DOCKER_WSL_IP=127.0.0.1:2375
SANDBOX_TARGET=/app
SANDBOX_MOUNT=/mnt/d/python/cloud-agent/sandbox/mounts/workspace
WORKSPACE_BASE=D:\python\cloud-agent\sandbox\mounts\workspace
DOCKER_WORKSPACE_BASE=D:\python\cloud-agent\sandbox\mounts\workspace
# Sandbox container resource limits (defaults, configurable in /admin?tab=containers)
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_CPU_LIMIT=2.0
SANDBOX_PIDS_LIMIT=500

# --- Networking & Wildcard Preview Proxy ---
PORT=8000
PREVIEW_BASE_DOMAIN=lvh.me

# --- Intent Analyzer Agent (Fast routing/title generation) ---
INTENT_MODEL=openai/gpt-oss-20b
INTENT_BASE_URL=https://api.groq.com/openai/v1
INTENT_MODEL_KEY=
